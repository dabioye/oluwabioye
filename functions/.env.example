# Copy to functions/.env before deploying from your machine (GitHub Actions writes it for you).
BASE_URL=https://sarahanddamilare.dabioye.com
INVITE_URL=https://oluwabioye.dabioye.com

# WhatsApp Cloud API (Meta). Phone number ID from WhatsApp Manager → API setup ("none" = the one in config.js).
WHATSAPP_PHONE_ID=none
WHATSAPP_TEMPLATE=oluwabioye_invitation
# Only used if the template can't be read from Meta (the template's own language is used otherwise).
WHATSAPP_LANG=en
# Only for a template with an IMAGE header sent without the guest's card (auto-send), e.g. a fixed picture.
WHATSAPP_HEADER_IMAGE=none
# Your own number: an alert (template guest_reply_alert) arrives here whenever a guest replies.
WHATSAPP_ALERT_TO=none
